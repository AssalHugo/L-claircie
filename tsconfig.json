{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Les scripts de vérification importent la logique pure de l'Edge Function
    // (supabase/functions/etl-nightly/lib.ts), qui doit garder l'extension .ts
    // explicite pour rester importable par Deno. Sans effet à l'émission (noEmit).
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // supabase/functions/etl-nightly/index.ts tourne sous Deno (globale `Deno`,
  // imports HTTP esm.sh) : il ne peut pas être typé par la config Next.
  // Il se vérifie avec `deno check supabase/functions/etl-nightly/index.ts`.
  // lib.ts reste couvert, car importé par scripts/04-verify-etl-mapping.ts.
  "exclude": ["node_modules", "supabase/functions"]
}
